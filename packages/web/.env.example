# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Analytics (WIC-814 client instrumentation)
# Sink is provider-agnostic and defaults to a no-op so nothing emits until wired.
#   noop (default) | console (log to devtools) | posthog
VITE_ANALYTICS_SINK=noop
# Required when VITE_ANALYTICS_SINK=posthog
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
