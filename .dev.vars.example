# Cloudflare Workers local dev secrets (copy to .dev.vars, never commit .dev.vars)
# wrangler dev reads these automatically as Worker secrets/vars
#
# Binding names match packages/api/src/types/env.ts (Env interface)

# Supabase auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# The owner local dev runs as when auth is bypassed (ADR-010 D3).
#
# The bypass fires only when BOTH SUPABASE_URL and SUPABASE_JWT_SECRET are
# absent -- comment out both lines above to use it. Setting just one leaves
# /api/* requiring a valid JWT, and this variable then has no effect at all.
#
# When it does fire, local dev is one specific tenant rather than no tenant, so
# every tenancy predicate runs its owner branch exactly as it does in
# production. Defaults to the sentinel migration 0017 backfills pre-tenancy rows
# to, so a fresh local database's legacy rows are already owned by this id.
# Point it at a real user's uuid to develop against that user's data instead.
# LOCAL_DEV_USER_ID=00000000-0000-0000-0000-000000000000

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Database — REQUIRED for `npm run dev:worker`.
# That script is a bare `wrangler dev` with no --env, so it loads the top-level
# wrangler.jsonc, which declares NO hyperdrive binding (the binding and its
# localConnectionString exist only under env.preview). db/client.ts resolves
# HYPERDRIVE -> DATABASE_URL -> Node singleton, so local Worker dev takes the
# DATABASE_URL path -- the same one production takes. Leave this unset and the
# Worker runs with no database: /health reports "db":"not_applicable".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Note: R2_BUCKET is a native binding defined in wrangler.jsonc — no env var needed.
# wrangler dev automatically provides a local R2 bucket emulation.

# Stripe billing — "Careerpin Pro" tier (WIC-2642 / WIC-2570).
# Use TEST-mode keys for local dev and preview. Get them from the Stripe
# Dashboard in TEST mode: Developers → API keys. Full setup + go-live steps are
# in docs/STRIPE_INTEGRATION.md. Leave all four unset to run with billing
# disabled — the backend treats an absent STRIPE_SECRET_KEY / STRIPE_PRICE_PRO as
# "billing not configured" and the Pro checkout is simply unavailable.
#
# Secret — Stripe test secret key (server-side). Never commit the real value.
STRIPE_SECRET_KEY=sk_test_...
# Secret — webhook signing secret. For local dev this is printed by the Stripe
# CLI when you run `stripe listen` (see below); it starts with `whsec_`.
STRIPE_WEBHOOK_SECRET=whsec_...
# Non-secret — the recurring Price id for Careerpin Pro ($15/mo USD), captured
# from the TEST-mode Product/Price. In preview/prod this lives in wrangler.jsonc
# `vars`; locally it is read here. Starts with `price_`.
STRIPE_PRICE_PRO=price_...
# Non-secret — browser publishable key, baked into the web bundle at build time.
# Vite only exposes vars prefixed with VITE_. Starts with `pk_test_` (test mode).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Local webhook forwarding (Stripe CLI):
#   stripe login
#   stripe listen --forward-to http://localhost:8787/api/stripe/webhook
# `stripe listen` prints the `whsec_...` signing secret for this session — copy
# it into STRIPE_WEBHOOK_SECRET above. Use :8787 for `npm run dev:worker`
# (wrangler) or :3000 for `npm run dev:api` (Node). Trigger a test event with
# e.g. `stripe trigger checkout.session.completed`.
