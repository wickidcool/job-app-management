{
	"name": "jobtrail",
	// Entry point created by WIC-222 (Hono migration)
	"main": "packages/api/src/worker.ts",
	"compatibility_date": "2026-05-05",
	// nodejs_compat enables Node.js built-ins (crypto, stream, etc.) needed by drizzle-orm and dependencies
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Static frontend assets. The asset router runs before the Worker: a request that
	// matches a file on disk is served directly, anything else is forwarded to `main`.
	// Because a Worker script is present, `not_found_handling` is NOT applied automatically
	// on that forward — it only takes effect for explicit ASSETS.fetch() calls. So the
	// `binding` below is required, and app.ts's notFound handler calls it to serve the SPA
	// shell for client-side routes (WIC-1004).
	"assets": {
		"directory": "./packages/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	// R2: object storage for resume files and cover letters
	// Setup: wrangler r2 bucket create jobtrail-documents
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "jobtrail-documents"
		}
	],
	// Non-secret environment variables (secrets go in .dev.vars locally or via `wrangler secret put` for prod)
	"vars": {
		"NODE_ENV": "production",
		// Analytics sink (WIC-821): route the 9 instrumented events to PostHog.
		// These are non-secret config, so they live here rather than in the CI secrets
		// block. The only secret is POSTHOG_API_KEY, injected by deploy.yml from the
		// GitHub `production` environment. If that key is ever unset, config.ts +
		// analytics.service.ts fall back to the noop sink with a warning.
		"ANALYTICS_SINK": "posthog",
		"POSTHOG_HOST": "https://us.i.posthog.com"
	},
	// WIC-1386: production Hyperdrive binding (ADR-007 opt 1). Without this the
	// Worker cannot reach the Supabase pooler and every authenticated route 503s.
	// NOTE: this id is the PRODUCTION config. The one under env.preview points at
	// the DEV database - the two must never be the same value.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "e377f34016834bdab7f34ce2c629128d"
		}
	],
	"observability": {
		"enabled": true
	},
	// Preview environment — used by PR preview deployments (wrangler deploy --env preview)
	"env": {
		"preview": {
			"name": "jobtrail-preview",
			"vars": {
				"NODE_ENV": "development"
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "374db58fe1014823a9e54ba393125676",
					"localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
				}
			],
			"r2_buckets": [
				{
					"binding": "R2_BUCKET",
					"bucket_name": "jobtrail-documents-dev"
				}
			]
		}
	}
}
